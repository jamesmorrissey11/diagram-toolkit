      "title": "Why Codex can stay coherent on long tasks",
      "type": "agent",
      "preset": "concept",
      "groups": [
       {
        "id": "harness",
        "label": "Why Codex stays coherent: a loop, not one giant prompt",
        "kind": "boundary",
        "row": 0,
        "col": 0
       }
      ],
      "nodes": [
       {
        "id": "state",
        "label": "Externalized state",
        "sub": "Repo, docs, worktrees",
        "role": "support",
        "group": "harness",
        "row": 0,
        "col": 0
       },
       {
        "id": "agent",
