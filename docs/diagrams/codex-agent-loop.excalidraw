        "row": 1,
        "col": 1
       },
       {
        "id": "human",
        "label": "Human steering",
        "sub": "Course-correct mid-task",
        "role": "terminal",
        "group": "harness",
        "row": 0,
        "col": 2
       },
       {
        "id": "plan",
        "label": "1. Plan",
        "sub": "Pick the next milestone",
        "role": "support",
        "group": "harness",
        "row": 2,
        "col": 1
       },
       {
        "id": "edit",
        "label": "2. Edit code",
        "sub": "Make scoped changes",
        "role": "support",
        "group": "harness",
        "row": 2,
        "col": 2
       },
       {
        "id": "tools",
        "label": "3. Run tests / build / lint",
        "sub": "Tests / build / lint",
        "role": "support",
        "group": "harness",
        "row": 3,
        "col": 2
       },
       {
        "id": "observe",
        "label": "4. Observe real feedback",
        "sub": "Read errors, diffs, logs",
        "role": "support",
        "group": "harness",
        "row": 3,
        "col": 1
       },
       {
        "id": "repair",
        "label": "5. Repair failures",
        "sub": "Fix failures; re-check",
        "role": "support",
        "group": "harness",
        "row": 3,
        "col": 0
       },
       {
        "id": "document",
        "label": "6. Update docs / status",
        "sub": "Save progress + decisions",
        "role": "support",
        "group": "harness",
        "row": 2,
        "col": 0
       }
