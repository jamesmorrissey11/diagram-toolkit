     "spec": {
      "version": 1,
      "id": "v01-lifecycle",
      "direction": "LR",
      "displayWidth": 1400,
      "title": "The agentic delivery lifecycle",
      "subtitle": "Humans approve at gates; agents work in isolation; checks and reviewers close each loop.",
      "source": "agentic-agile-template, GitHub Copilot docs, Superpowers, Codex (verified 2026-11)",
      "type": "workflow",
      "preset": "concept",
      "layout": "lanes",
      "lanes": [
       {
        "id": "human",
        "label": "Human"
       },
       {
        "id": "agent",
        "label": "Agent"
       },
       {
        "id": "check",
        "label": "Review & CI"
       },
       {
        "id": "platform",
        "label": "Platform"
       }
      ],
      "phases": [
       {
        "label": "Align",
        "from": 0,
        "to": 1
       },
       {
        "label": "Plan",
        "from": 2,
        "to": 2
       },
       {
        "label": "Build",
        "from": 3,
        "to": 4
       },
       {
        "label": "Ship",
        "from": 5,
        "to": 5
       },
       {
        "label": "Learn",
        "from": 6,
        "to": 6
       }
      ],
      "nodes": [
       {
        "id": "intake",
        "label": "Write issue",
        "sub": "Goal + criteria",
        "lane": "human",
        "step": 0
       },
       {
        "id": "explore",
        "label": "Explore",
        "sub": "Research · questions",
        "lane": "agent",
        "step": 0
       },
