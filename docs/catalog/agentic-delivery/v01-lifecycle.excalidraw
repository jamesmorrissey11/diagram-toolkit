        "id": "spec",
        "label": "Draft spec",
        "sub": "Scope · ownership",
        "lane": "agent",
        "step": 1
       },
       {
        "id": "okspec",
        "label": "Spec OK?",
        "lane": "human",
        "step": 1,
        "role": "gate"
       },
       {
        "id": "plan",
        "label": "Plan waves",
        "sub": "Stories · deps",
        "lane": "agent",
        "step": 2
       },
       {
        "id": "okplan",
        "label": "Plan OK?",
        "lane": "human",
        "step": 2,
        "role": "gate"
       },
       {
        "id": "execute",
        "label": "Execute",
        "sub": "Worktree · TDD",
        "lane": "agent",
        "step": 3
       },
       {
        "id": "verify",
        "label": "Verify",
        "sub": "Tests · lint · scans",
        "lane": "check",
        "step": 3
       },
       {
        "id": "review",
        "label": "Review",
        "sub": "Independent agent",
        "lane": "check",
        "step": 4
       },
       {
        "id": "merge",
        "label": "Merge?",
        "lane": "human",
        "step": 4,
        "role": "gate"
       },
       {
        "id": "promote",
        "label": "Promote",
        "sub": "dev → staging",
        "lane": "platform",
        "step": 5
       },
       {
        "id": "release",
        "label": "Release?",
        "lane": "human",
        "step": 5,
        "role": "gate"
       },
       {
        "id": "learn",
        "label": "Retro",
        "sub": "Docs · log · lessons",
        "lane": "agent",
        "step": 6
       }
      ],
