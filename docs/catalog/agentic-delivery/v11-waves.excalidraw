        "label": "yes"
       }
      ],
      "callouts": [
       {
        "id": "own",
        "title": "Disjoint ownership",
        "text": "No two stories in a wave share files or platform resources: bundle resources, Unity Catalog objects, ontology types.",
        "refs": [
         "s1",
         "s2",
         "s3"
        ],
        "tone": "yellow"
       },
       {
        "id": "gate",
        "title": "Wave review gate",
        "text": "A human reviews every wave PR and fixes the interfaces before the next wave launches.",
        "refs": [
         "gate1",
         "gate2"
        ],
        "tone": "blue"
       },
       {
        "id": "fleet",
        "title": "Fan out with /fleet",
        "text": "An orchestrator splits a wave into subagents, each with its own context window.",
        "tone": "green"
       }
