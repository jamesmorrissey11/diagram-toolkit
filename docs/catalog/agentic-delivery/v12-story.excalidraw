       },
       {
        "id": "own",
        "label": "Ownership",
        "sub": "Files or platform resources",
        "group": "story",
        "badge": 5
       },
       {
        "id": "ac",
        "label": "Acceptance criteria",
        "sub": "Testable, observable",
        "group": "story",
        "badge": 6
       },
       {
        "id": "neg",
        "label": "Negative constraints",
        "sub": "What must not change",
        "group": "story",
