      "id": "v12-story",
      "direction": "LR",
      "displayWidth": 900,
      "title": "Anatomy of an agent-ready story",
      "subtitle": "A story an agent can finish alone states its scope, what it owns and how it is accepted.",
      "source": "agentic-agile-template: agentic-story.md, agentic-review-cycle.md (verified 2026-11)",
      "type": "concept",
      "preset": "concept",
      "layout": "card",
      "glossary": "./glossary.json",
