       {
        "id": "deps",
        "label": "Dependencies",
        "sub": "Blocking stories · wave",
        "group": "story",
        "badge": 8
       },
       {
        "id": "cycle",
        "label": "Review cycle",
        "sub": "Optional · stop condition",
        "group": "story",
        "badge": 9
       }
      ],
      "edges": [],
      "callouts": [
       {
        "id": "core",
        "title": "Three fixed sections",
        "text": "Scope, Ownership and Acceptance criteria are the template’s stable core; platform variants keep them.",
        "refs": [
         "scope",
         "own",
         "ac"
        ],
        "tone": "blue"
       },
       {
        "id": "why-own",
        "title": "Why ownership matters",
        "text": "Disjoint files or platform resources (bundle resources, Unity Catalog objects) let agents run in parallel waves.",
        "refs": [
         "own"
        ],
        "tone": "yellow"
       },
       {
        "id": "why-ac",
        "title": "Criteria end the run",
        "text": "Testable criteria are what the agent self-reviews against and what reviewers check before merge.",
        "refs": [
         "ac"
        ],
        "tone": "green"
       }
      ]
